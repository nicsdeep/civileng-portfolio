{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/p/:slug",
      "destination": "/api/portfolio-page?slug=:slug"
    },
    {
      "source": "/p/:slug/:section*",
      "destination": "/api/portfolio-page?slug=:slug&section=:section*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
