# Copy to .env.local for local development. Never commit real values.
# All three are public by design (they end up in browser code); Row Level
# Security in supabase/migrations protects the data.

# Shared CivilEng Supabase project (same as ResearchHub). Optional: the app
# falls back to these values if they are missing.
VITE_SUPABASE_URL=https://iealljnqewqyojtlgheh.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# The Supabase user ID whose published portfolio the public site shows.
# Sign in, open /editor and copy the ID shown there. Until this is set (or
# while nothing is published) the site shows the CV bundled in src/content/cv.ts.
VITE_PORTFOLIO_OWNER_ID=
